---
import BaseLayout from '../../layouts/BaseLayout.astro';

const essays = [
  {
    slug: 'put-on-the-tie',
    titleEn: 'Put on the Tie',
    titleZh: '把领带系上',
    date: 'Jun 23, 2026',
    readTime: '2 min read',
    deck: 'A sentence I misread in a photography book, and the quiet discipline it left behind.',
  },
];
---

<BaseLayout title="Wandering" description="Short essays on thought, memory, and small shifts in perspective.">
  <div class="writing-index">
    <h1 class="sr-only">Wandering</h1>
    <section class="essay-list" aria-label="Short essays">
      {essays.map((essay, i) => (
        <a class="essay-row" href={`/writing/${essay.slug}`}>
          <div class="essay-index">{(i + 1).toString().padStart(2, '0')}</div>
          <div class="essay-title-block">
            <h2>{essay.titleEn}</h2>
            <span class="essay-zh">{essay.titleZh}</span>
            <p class="essay-deck">{essay.deck}</p>
          </div>
          <div class="essay-meta">
            <span>{essay.date}</span>
            <span>{essay.readTime}</span>
          </div>
        </a>
      ))}
    </section>
  </div>
</BaseLayout>

<style>
  .writing-index {
    max-width: 960px;
    margin: 0 auto;
    padding: 72px clamp(20px, 6vw, 80px) 120px;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .essay-index,
  .essay-meta {
    font-family: var(--sans);
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--stone);
  }

  .essay-list {
    border-top: 1px solid var(--rule);
  }

  .essay-row {
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr) 110px;
    gap: clamp(16px, 3vw, 36px);
    align-items: baseline;
    padding: 28px 0 30px;
    border-bottom: 1px solid var(--rule);
    color: inherit;
    text-decoration: none;
    transition: opacity 0.18s;
  }

  .essay-row:hover {
    opacity: 0.7;
  }

  .essay-index {
    color: var(--rose);
  }

  h2 {
    display: inline;
    font-family: var(--serif);
    font-size: clamp(21px, 2vw, 24px);
    font-weight: 400;
    font-style: italic;
    line-height: 1.3;
    color: var(--ink);
    margin: 0;
  }

  .essay-zh {
    display: inline;
    margin-left: 12px;
    font-family: var(--serif);
    font-size: 14px;
    letter-spacing: 0.08em;
    color: var(--rose);
  }

  .essay-deck {
    margin: 8px 0 0;
    font-family: var(--serif);
    font-size: clamp(16px, 1.6vw, 18px);
    font-weight: 400;
    line-height: 1.65;
    color: var(--ink);
  }

  .essay-meta {
    display: flex;
    flex-direction: column;
    gap: 6px;
    align-items: flex-end;
    text-align: right;
  }

  @media (max-width: 640px) {
    .writing-index {
      padding-top: 48px;
    }

    .essay-row {
      grid-template-columns: 1fr;
      gap: 10px;
    }

    .essay-meta {
      flex-direction: row;
      gap: 16px;
      align-items: center;
      text-align: left;
    }
  }
</style>
