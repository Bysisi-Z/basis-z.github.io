---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { albums } from '../../../lib/gallery.mjs';

export function getStaticPaths() {
  return albums.map((album, i) => ({
    params: { slug: album.slug },
    props: { album, next: albums[(i + 1) % albums.length] },
  }));
}

const { album, next } = Astro.props;
const lightbox = album.photos.map((p) => ({ src: p.full, srcset: p.srcset, w: p.width, h: p.height, caption: p.caption || '' }));
---

<BaseLayout title={`${album.title} — Nature Never Judges`} description={`${album.photos.length} photographs · ${album.place} · ${album.date}`}>
  <div class="gal">
    <!-- Hero: the cover, full bleed -->
    <section class="ah">
      <img
        class="ah-img"
        src={album.cover.full}
        srcset={album.cover.srcset}
        sizes="100vw"
        width={album.cover.width}
        height={album.cover.height}
        alt={`${album.title}, ${album.place}`}
        fetchpriority="high"
      />
      <div class="ah-shade" aria-hidden="true"></div>
      <a class="ah-back" href="/photography">← All albums</a>
      <div class="ah-text">
        <p class="ah-num">Album {album.number}</p>
        <h1 class="ah-title">{album.title}</h1>
        <p class="ah-meta">{album.place}<span>·</span>{album.date}<span>·</span>{album.photos.length} photographs</p>
      </div>
    </section>

    {album.intro && <p class="a-intro">{album.intro}</p>}

    <!-- Photos at their own proportions, justified rows -->
    <div class="jg" data-lightbox={JSON.stringify(lightbox)}>
      {album.photos.map((p) => (
        <button class="jg-item" type="button" style={`--ar:${p.ratio.toFixed(4)}`} data-i={p.index} aria-label={`Open photo ${p.index + 1} of ${album.photos.length}`}>
          <i aria-hidden="true"></i>
          <img
            src={p.thumb}
            srcset={p.srcset}
            sizes="(max-width: 700px) 100vw, 40vw"
            width={p.width}
            height={p.height}
            alt={p.caption || `${album.title}, photo ${p.index + 1}`}
            loading="lazy"
            decoding="async"
          />
        </button>
      ))}
    </div>

    <footer class="a-foot">
      {album.guide && (
        <a class="a-guide" href={album.guide}>
          <span class="a-foot-label">The trail guide</span>
          <span class="a-foot-title">Read the story behind these photos <span aria-hidden="true">→</span></span>
        </a>
      )}
      {next && next.slug !== album.slug && (
        <a class="a-next" href={`/photography/album/${next.slug}`}>
          <img src={next.cover.thumb} width={next.cover.width} height={next.cover.height} alt="" loading="lazy" decoding="async" />
          <span class="a-next-text">
            <span class="a-foot-label">Next album · {next.number}</span>
            <span class="a-foot-title">{next.title} <span aria-hidden="true">→</span></span>
          </span>
        </a>
      )}
    </footer>

    <!-- Lightbox -->
    <div class="lb" id="lb" role="dialog" aria-modal="true" aria-label="Photo viewer" hidden>
      <figure class="lb-fig">
        <img class="lb-img" alt="" />
        <span class="lb-sig" aria-hidden="true">Si</span>
      </figure>
      <div class="lb-bar">
        <p class="lb-cap"></p>
        <p class="lb-count"></p>
      </div>
      <button class="lb-btn lb-close" type="button" aria-label="Close">
        <svg viewBox="0 0 24 24" fill="none"><path d="M5 5l14 14M19 5L5 19" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>
      </button>
      <button class="lb-btn lb-prev" type="button" aria-label="Previous photo">
        <svg viewBox="0 0 24 24" fill="none"><path d="M15 4l-8 8 8 8" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      <button class="lb-btn lb-next" type="button" aria-label="Next photo">
        <svg viewBox="0 0 24 24" fill="none"><path d="M9 4l8 8-8 8" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
    </div>
  </div>
</BaseLayout>

<style is:global>
  body:has(.gal) { background: #0C0C0B; }
  body:has(.gal) .top-nav { background: rgba(12, 12, 11, 0.9); border-bottom-color: rgba(236, 232, 225, 0.08); }
  body:has(.gal) .nav-home,
  body:has(.gal) .nav-current,
  body:has(.gal) .nav-link { color: #8A857E; }
  body:has(.gal) .nav-sep { color: #33322F; }
  body:has(.gal) .nav-link:hover { color: #ECE8E1; }
  body:has(.gal) .nav-link.active { background: #ECE8E1; color: #0C0C0B; }
  body:has(.gal) .site-footer { background: #0C0C0B; border-top-color: rgba(236, 232, 225, 0.08); }
  body.lb-open { overflow: hidden; }
</style>

<style>
  .gal {
    --g-ink: #ECE8E1;
    --g-soft: #B8B2A9;
    --g-muted: #7E7972;
    --g-rule: rgba(236, 232, 225, 0.12);
    --nav-h: 52px;
    background: #0C0C0B;
    color: var(--g-ink);
  }
  @media (max-width: 1024px) { .gal { --nav-h: 84px; } }

  /* ── Hero ── */
  .ah {
    position: relative;
    height: calc(100svh - var(--nav-h));
    min-height: 460px;
    overflow: hidden;
  }
  .ah-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    animation: ah-in 2.4s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  @keyframes ah-in { from { transform: scale(1.06); opacity: 0; } to { transform: scale(1); opacity: 1; } }
  .ah-shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to bottom, rgba(12,12,11,0.55) 0%, rgba(12,12,11,0) 22%),
      linear-gradient(to top, rgba(12,12,11,0.92) 0%, rgba(12,12,11,0.45) 32%, rgba(12,12,11,0) 62%);
  }
  .ah-text {
    position: absolute;
    left: clamp(20px, 6vw, 96px);
    right: clamp(20px, 6vw, 96px);
    bottom: clamp(36px, 6vw, 88px);
    animation: ah-text 1.6s 0.5s ease both;
  }
  @keyframes ah-text { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
  .ah-back {
    position: absolute;
    top: clamp(20px, 3vw, 40px);
    left: clamp(20px, 6vw, 96px);
    z-index: 2;
    padding: 9px 16px;
    border-radius: 999px;
    background: rgba(12, 12, 11, 0.42);
    -webkit-backdrop-filter: blur(10px);
            backdrop-filter: blur(10px);
    font-family: var(--sans);
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--g-ink);
    text-decoration: none;
    transition: background 0.3s;
  }
  .ah-back:hover { background: rgba(12, 12, 11, 0.62); }
  .ah-num {
    margin: 0 0 12px;
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(18px, 1.6vw, 24px);
    color: var(--g-soft);
  }
  .ah-title {
    margin: 0;
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(52px, 9vw, 148px);
    line-height: 0.92;
    letter-spacing: -0.02em;
  }
  .ah-meta {
    margin: clamp(18px, 2vw, 28px) 0 0;
    font-family: var(--sans);
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--g-soft);
  }
  .ah-meta span { margin: 0 10px; opacity: 0.5; }

  .a-intro {
    max-width: 640px;
    margin: clamp(56px, 7vw, 110px) auto 0;
    padding: 0 24px;
    text-align: center;
    font-family: var(--serif);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(20px, 1.8vw, 26px);
    line-height: 1.6;
    color: var(--g-soft);
  }

  /* ── Justified rows: each photo grows in proportion to its aspect ratio ── */
  .jg {
    --rh: clamp(200px, 26vw, 420px);
    --gap: clamp(4px, 0.5vw, 8px);
    display: flex;
    flex-wrap: wrap;
    justify-content: center;   /* a short last row sits centred */
    gap: var(--gap);
    max-width: 1760px;
    margin: clamp(56px, 7vw, 110px) auto 0;
    padding: 0 clamp(12px, 3vw, 48px);
  }
  .jg-item {
    position: relative;
    flex-grow: calc(var(--ar) * 100);
    flex-basis: calc(var(--ar) * var(--rh));
    max-width: calc(var(--ar) * var(--rh) * 1.6);   /* full rows rarely stretch this far; stops a lone last photo blowing up */
    padding: 0;
    border: 0;
    background: #161614;
    cursor: zoom-in;
    overflow: hidden;
    opacity: 0;
    transform: translateY(18px);
    transition: opacity 1.1s ease, transform 1.1s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .jg-item.in { opacity: 1; transform: none; }
  .jg-item i { display: block; padding-bottom: calc(100% / var(--ar)); }
  .jg-item img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 1.4s cubic-bezier(0.2, 0.7, 0.2, 1), filter 1.4s ease;
    filter: brightness(0.94);
  }
  .jg-item:hover img { transform: scale(1.025); filter: brightness(1.02); }
  .jg-item:focus-visible { outline: 1px solid var(--g-ink); outline-offset: 3px; }
  @media (max-width: 700px) { .jg { --rh: 160px; } .jg-item { max-width: none; } }

  /* ── Footer: trail guide + next album ── */
  .a-foot {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: clamp(20px, 3vw, 40px);
    max-width: 1400px;
    margin: clamp(90px, 11vw, 180px) auto 0;
    padding: 0 clamp(20px, 6vw, 96px) clamp(80px, 10vw, 150px);
  }
  .a-guide,
  .a-next {
    display: flex;
    align-items: center;
    gap: 24px;
    padding: clamp(22px, 2.4vw, 34px) 0;
    border-top: 1px solid var(--g-rule);
    color: var(--g-ink);
    text-decoration: none;
  }
  .a-guide { flex-direction: column; align-items: flex-start; gap: 12px; }
  .a-next img { width: clamp(96px, 10vw, 150px); aspect-ratio: 3 / 2; object-fit: cover; flex-shrink: 0; filter: brightness(0.9); transition: filter 0.6s; }
  .a-next:hover img { filter: brightness(1.05); }
  .a-next-text { display: flex; flex-direction: column; gap: 10px; }
  .a-foot-label {
    font-family: var(--sans);
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--g-muted);
  }
  .a-foot-title {
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(24px, 2.4vw, 34px);
    line-height: 1.15;
  }
  .a-foot-title span { display: inline-block; transition: transform 0.4s ease; }
  .a-guide:hover .a-foot-title span,
  .a-next:hover .a-foot-title span { transform: translateX(5px); }

  /* ── Lightbox ── */
  .lb {
    position: fixed;
    inset: 0;
    z-index: 10000;
    background: rgba(8, 8, 7, 0.97);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.45s ease;
    touch-action: pan-y;
  }
  .lb[hidden] { display: none; }
  .lb.show { opacity: 1; }
  .lb-fig {
    position: relative;
    margin: 0;
    max-width: calc(100vw - clamp(24px, 12vw, 200px));
    max-height: calc(100svh - 140px);
    display: flex;
  }
  .lb-img {
    display: block;
    max-width: 100%;
    max-height: calc(100svh - 140px);
    width: auto;
    height: auto;
    object-fit: contain;
    transition: opacity 0.35s ease;
    user-select: none;
    -webkit-user-drag: none;
  }
  .lb-img.fading { opacity: 0; }
  .lb-sig {
    position: absolute;
    right: 14px;
    bottom: 10px;
    font-family: var(--serif);
    font-style: italic;
    font-size: 20px;
    letter-spacing: 0.12em;
    color: #fff;
    opacity: 0.45;
    pointer-events: none;
  }
  .lb-bar {
    position: absolute;
    left: clamp(20px, 4vw, 56px);
    right: clamp(20px, 4vw, 56px);
    bottom: clamp(16px, 2.6vh, 30px);
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 24px;
  }
  .lb-bar p { margin: 0; }
  .lb-cap { font-family: var(--serif); font-style: italic; font-size: 17px; color: var(--g-soft); }
  .lb-count { font-family: var(--sans); font-size: 11px; letter-spacing: 0.22em; color: var(--g-muted); white-space: nowrap; }
  .lb-btn {
    position: absolute;
    width: 52px;
    height: 52px;
    display: grid;
    place-items: center;
    padding: 0;
    border: 0;
    background: none;
    color: var(--g-soft);
    cursor: pointer;
    transition: color 0.3s;
  }
  .lb-btn svg { width: 26px; height: 26px; }
  .lb-btn:hover { color: var(--g-ink); }
  .lb-close { top: clamp(10px, 2vh, 22px); right: clamp(10px, 2vw, 28px); }
  .lb-prev { left: clamp(4px, 1.5vw, 24px); top: 50%; transform: translateY(-50%); }
  .lb-next { right: clamp(4px, 1.5vw, 24px); top: 50%; transform: translateY(-50%); }
  @media (max-width: 700px) {
    .lb-prev, .lb-next { top: auto; bottom: 46px; transform: none; }
    .lb-fig { max-width: 100vw; }
  }

  @media (prefers-reduced-motion: reduce) {
    .ah-img, .ah-text { animation: none; }
    .jg-item { opacity: 1; transform: none; transition: none; }
  }
</style>

<script>
  const grid = document.querySelector<HTMLElement>('.jg');
  const items = Array.from(document.querySelectorAll<HTMLButtonElement>('.jg-item'));

  // reveal photos as they scroll in
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
    }, { rootMargin: '0px 0px -6% 0px' });
    items.forEach((el) => io.observe(el));
  } else {
    items.forEach((el) => el.classList.add('in'));
  }

  // lightbox
  type Slide = { src: string; srcset: string; w: number; h: number; caption: string };
  const slides: Slide[] = JSON.parse(grid?.dataset.lightbox || '[]');
  const lb = document.getElementById('lb')!;
  const img = lb.querySelector<HTMLImageElement>('.lb-img')!;
  const cap = lb.querySelector<HTMLElement>('.lb-cap')!;
  const count = lb.querySelector<HTMLElement>('.lb-count')!;
  let cur = 0;
  let lastFocus: HTMLElement | null = null;
  const pad = (n: number) => String(n).padStart(2, '0');

  function preload(i: number) {
    const s = slides[(i + slides.length) % slides.length];
    if (!s) return;
    const im = new Image();
    im.sizes = '100vw';
    im.srcset = s.srcset;
    im.src = s.src;
  }
  function show(i: number, animate = true) {
    cur = (i + slides.length) % slides.length;
    const s = slides[cur];
    const apply = () => {
      img.sizes = '100vw';
      img.srcset = s.srcset;
      img.src = s.src;
      img.width = s.w;
      img.height = s.h;
      img.alt = s.caption || `Photo ${cur + 1}`;
      cap.textContent = s.caption;
      count.textContent = `${pad(cur + 1)} — ${pad(slides.length)}`;
      img.classList.remove('fading');
    };
    if (animate) { img.classList.add('fading'); setTimeout(apply, 180); } else apply();
    preload(cur + 1); preload(cur - 1);
  }
  function open(i: number) {
    lastFocus = document.activeElement as HTMLElement;
    lb.hidden = false;
    document.body.classList.add('lb-open');
    show(i, false);
    requestAnimationFrame(() => lb.classList.add('show'));
    lb.querySelector<HTMLButtonElement>('.lb-close')!.focus();
  }
  function close() {
    lb.classList.remove('show');
    document.body.classList.remove('lb-open');
    setTimeout(() => { lb.hidden = true; }, 450);
    lastFocus?.focus();
  }

  items.forEach((el) => el.addEventListener('click', () => open(Number(el.dataset.i))));
  lb.querySelector('.lb-close')!.addEventListener('click', close);
  lb.querySelector('.lb-prev')!.addEventListener('click', () => show(cur - 1));
  lb.querySelector('.lb-next')!.addEventListener('click', () => show(cur + 1));
  lb.addEventListener('click', (e) => { if (e.target === lb) close(); });
  document.addEventListener('keydown', (e) => {
    if (lb.hidden) return;
    if (e.key === 'Escape') close();
    else if (e.key === 'ArrowRight') show(cur + 1);
    else if (e.key === 'ArrowLeft') show(cur - 1);
  });
  // swipe
  let sx = 0, sy = 0;
  lb.addEventListener('touchstart', (e) => { sx = e.touches[0].clientX; sy = e.touches[0].clientY; }, { passive: true });
  lb.addEventListener('touchend', (e) => {
    const dx = e.changedTouches[0].clientX - sx, dy = e.changedTouches[0].clientY - sy;
    if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)) show(cur + (dx < 0 ? 1 : -1));
    else if (dy > 90 && Math.abs(dy) > Math.abs(dx)) close();
  }, { passive: true });
  // no right-click save on the large image
  img.addEventListener('contextmenu', (e) => e.preventDefault());
</script>
