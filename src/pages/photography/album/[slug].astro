---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import GalleryLightbox from '../../../components/GalleryLightbox.astro';
import { albums, theme } from '../../../lib/gallery.mjs';
import '../../../styles/gallery.css';

export function getStaticPaths() {
  return albums.map((album, i) => ({
    params: { slug: album.slug },
    props: { album, next: albums[(i + 1) % albums.length] },
  }));
}

const { album, next } = Astro.props;
---

<BaseLayout title={`${album.title} — Nature Never Judges`} description={`${album.photos.length} photographs · ${album.place} · ${album.date}`}>
  <div class="gal" data-theme={theme}>
    <!-- Hero: the cover, full bleed -->
    <section class="ah">
      <img
        class="ah-img"
        src={album.cover.full}
        srcset={album.cover.srcset}
        sizes="100vw"
        width={album.cover.width}
        height={album.cover.height}
        alt={`${album.title}, ${album.place}`}
        fetchpriority="high"
      />
      <div class="ah-shade" aria-hidden="true"></div>
      <a class="ah-back" href="/photography">← All albums</a>
      <div class="ah-text">
        <p class="ah-num">Album {album.number}</p>
        <h1 class="ah-title">{album.title}</h1>
        <p class="ah-meta">{album.place}<span>·</span>{album.date}<span>·</span>{album.photos.length} photographs</p>
      </div>
    </section>

    {album.intro && <p class="a-intro">{album.intro}</p>}

    <!-- Square wall, centre-cropped; click opens the full frame -->
    <div class="sq-grid">
      {album.photos.map((p, i) => (
        <button class="sq-item" type="button" data-id={p.id} data-slide={p.slide} aria-label={`Open photo ${p.index + 1} of ${album.photos.length}`}>
          <img
            src={p.thumb}
            width={p.width}
            height={p.height}
            alt={p.caption || `${album.title}, photo ${p.index + 1}`}
            loading={i < 8 ? 'eager' : 'lazy'}
            decoding="async"
          />
        </button>
      ))}
    </div>

    <footer class="a-foot">
      {album.guide && (
        <a class="a-guide" href={album.guide}>
          <span class="a-foot-label">The trail guide</span>
          <span class="a-foot-title">Read the story behind these photos <span aria-hidden="true">→</span></span>
        </a>
      )}
      {next && next.slug !== album.slug && (
        <a class="a-next" href={`/photography/album/${next.slug}`}>
          <img src={next.cover.thumb} width={next.cover.width} height={next.cover.height} alt="" loading="lazy" decoding="async" />
          <span class="a-next-text">
            <span class="a-foot-label">Next album · {next.number}</span>
            <span class="a-foot-title">{next.title} <span aria-hidden="true">→</span></span>
          </span>
        </a>
      )}
    </footer>

    <GalleryLightbox />
  </div>
</BaseLayout>

<style>
  .gal {
    --nav-h: 52px;
  }
  @media (max-width: 1024px) { .gal { --nav-h: 84px; } }

  /* ── Hero ── */
  .ah {
    --g-ink: #F4F1EC;      /* text sits on the photo: always light */
    --g-soft: #D6D0C7;
    color: var(--g-ink);
    position: relative;
    height: calc(100svh - var(--nav-h));
    min-height: 460px;
    overflow: hidden;
  }
  .ah-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    animation: ah-in 2.4s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  @keyframes ah-in { from { transform: scale(1.06); opacity: 0; } to { transform: scale(1); opacity: 1; } }
  .ah-shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to bottom, rgba(12,12,11,0.55) 0%, rgba(12,12,11,0) 22%),
      linear-gradient(to top, rgba(12,12,11,0.92) 0%, rgba(12,12,11,0.45) 32%, rgba(12,12,11,0) 62%);
  }
  .ah-text {
    position: absolute;
    left: clamp(20px, 6vw, 96px);
    right: clamp(20px, 6vw, 96px);
    bottom: clamp(36px, 6vw, 88px);
    animation: ah-text 1.6s 0.5s ease both;
  }
  @keyframes ah-text { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
  .ah-back {
    position: absolute;
    top: clamp(20px, 3vw, 40px);
    left: clamp(20px, 6vw, 96px);
    z-index: 2;
    padding: 9px 16px;
    border-radius: 999px;
    background: rgba(12, 12, 11, 0.42);
    color: #F4F1EC;
    -webkit-backdrop-filter: blur(10px);
            backdrop-filter: blur(10px);
    font-family: var(--sans);
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--g-ink);
    text-decoration: none;
    transition: background 0.3s;
  }
  .ah-back:hover { background: rgba(12, 12, 11, 0.62); }
  .ah-num {
    margin: 0 0 12px;
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(18px, 1.6vw, 24px);
    color: var(--g-soft);
  }
  .ah-title {
    margin: 0;
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(52px, 9vw, 148px);
    line-height: 0.92;
    letter-spacing: -0.02em;
  }
  .ah-meta {
    margin: clamp(18px, 2vw, 28px) 0 0;
    font-family: var(--sans);
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--g-soft);
  }
  .ah-meta span { margin: 0 10px; opacity: 0.5; }

  .a-intro {
    max-width: 640px;
    margin: clamp(56px, 7vw, 110px) auto 0;
    padding: 0 24px;
    text-align: center;
    font-family: var(--serif);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(20px, 1.8vw, 26px);
    line-height: 1.6;
    color: var(--g-soft);
  }

  /* ── Square wall ── */
  .sq-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(clamp(150px, 17vw, 300px), 1fr));
    gap: clamp(3px, 0.35vw, 6px);
    max-width: 1760px;
    margin: clamp(48px, 6vw, 96px) auto 0;
    padding: 0 clamp(12px, 3vw, 48px);
  }
  .sq-item {
    position: relative;
    aspect-ratio: 1;
    padding: 0;
    border: 0;
    background: var(--g-tile);
    overflow: hidden;
    cursor: zoom-in;
    opacity: 0;
    transform: translateY(14px);
    transition: opacity 1s ease, transform 1s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .sq-item.in { opacity: 1; transform: none; }
  .sq-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: brightness(0.93);
    transition: transform 1.2s cubic-bezier(0.2, 0.7, 0.2, 1), filter 0.8s ease;
  }
  .sq-item:hover img { transform: scale(1.04); filter: brightness(1.04); }
  .sq-item:focus-visible { outline: 1px solid var(--g-ink); outline-offset: 2px; }
  @media (max-width: 700px) { .sq-grid { grid-template-columns: repeat(2, 1fr); } }

  /* ── Footer: trail guide + next album ── */
  .a-foot {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: clamp(20px, 3vw, 40px);
    max-width: 1400px;
    margin: clamp(90px, 11vw, 180px) auto 0;
    padding: 0 clamp(20px, 6vw, 96px) clamp(80px, 10vw, 150px);
  }
  .a-guide,
  .a-next {
    display: flex;
    align-items: center;
    gap: 24px;
    padding: clamp(22px, 2.4vw, 34px) 0;
    border-top: 1px solid var(--g-rule);
    color: var(--g-ink);
    text-decoration: none;
  }
  .a-guide { flex-direction: column; align-items: flex-start; gap: 12px; }
  .a-next img { width: clamp(96px, 10vw, 150px); aspect-ratio: 3 / 2; object-fit: cover; flex-shrink: 0; filter: brightness(0.9); transition: filter 0.6s; }
  .a-next:hover img { filter: brightness(1.05); }
  .a-next-text { display: flex; flex-direction: column; gap: 10px; }
  .a-foot-label {
    font-family: var(--sans);
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--g-muted);
  }
  .a-foot-title {
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(24px, 2.4vw, 34px);
    line-height: 1.15;
  }
  .a-foot-title span { display: inline-block; transition: transform 0.4s ease; }
  .a-guide:hover .a-foot-title span,
  .a-next:hover .a-foot-title span { transform: translateX(5px); }

  @media (prefers-reduced-motion: reduce) {
    .ah-img, .ah-text { animation: none; }
    .sq-item { opacity: 1; transform: none; transition: none; }
  }
</style>

<script>
  // reveal squares as they scroll in (viewer lives in GalleryLightbox)
  const items = Array.from(document.querySelectorAll<HTMLElement>('.sq-item'));
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
    }, { rootMargin: '0px 0px -6% 0px' });
    items.forEach((el) => io.observe(el));
  } else {
    items.forEach((el) => el.classList.add('in'));
  }
</script>
