---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { albums, totalPhotos } from '../../lib/gallery.mjs';
---

<BaseLayout title="Nature Never Judges" description="Photographs from the Swiss Alps — trails walked, peaks reached, silences found.">
  <div class="gal">
    <header class="gal-head">
      <p class="gal-kicker">03 <span>·</span> Photography</p>
      <h1 class="gal-title">Nature never judges</h1>
      <div class="gal-sub">
        <p>Trails walked, peaks reached, silences found.</p>
        <p class="gal-count">{albums.length} albums <span>·</span> {totalPhotos} photographs <span>·</span> <a href="/trails">Trails map →</a></p>
      </div>
    </header>

    <ol class="gal-albums">
      {albums.map((a, i) => (
        <li class={`album-row${i % 2 ? ' album-row--flip' : ''}`}>
          <a class="album-cover" href={`/photography/album/${a.slug}`} aria-label={`${a.title} — ${a.photos.length} photographs`}>
            <img
              src={a.cover.thumb}
              srcset={a.cover.srcset}
              sizes="(max-width: 860px) 100vw, 62vw"
              width={a.cover.width}
              height={a.cover.height}
              alt={`${a.title}, ${a.place}`}
              loading={i === 0 ? 'eager' : 'lazy'}
              decoding="async"
            />
          </a>
          <div class="album-text">
            <span class="album-num">{a.number}</span>
            <h2 class="album-title"><a href={`/photography/album/${a.slug}`}>{a.title}</a></h2>
            <p class="album-meta">{a.place}<span>·</span>{a.date}</p>
            {a.intro && <p class="album-intro">{a.intro}</p>}
            <a class="album-link" href={`/photography/album/${a.slug}`}>{a.photos.length} photographs <span aria-hidden="true">→</span></a>
          </div>
        </li>
      ))}
    </ol>
  </div>
</BaseLayout>

<style is:global>
  /* dark gallery: nav + footer follow (same pattern as S² Capital) */
  body:has(.gal) { background: #0C0C0B; }
  body:has(.gal) .top-nav { background: rgba(12, 12, 11, 0.9); border-bottom-color: rgba(236, 232, 225, 0.08); }
  body:has(.gal) .nav-home,
  body:has(.gal) .nav-current,
  body:has(.gal) .nav-link { color: #8A857E; }
  body:has(.gal) .nav-sep { color: #33322F; }
  body:has(.gal) .nav-link:hover { color: #ECE8E1; }
  body:has(.gal) .nav-link.active { background: #ECE8E1; color: #0C0C0B; }
  body:has(.gal) .site-footer { background: #0C0C0B; border-top-color: rgba(236, 232, 225, 0.08); }
</style>

<style>
  .gal {
    --g-ink: #ECE8E1;
    --g-soft: #B8B2A9;
    --g-muted: #7E7972;
    --g-rule: rgba(236, 232, 225, 0.12);
    background: #0C0C0B;
    color: var(--g-ink);
    padding: clamp(64px, 9vw, 140px) clamp(20px, 6vw, 96px) clamp(80px, 10vw, 160px);
  }

  /* ── Header ── */
  .gal-head {
    max-width: 1400px;
    margin: 0 auto clamp(64px, 9vw, 140px);
  }
  .gal-kicker {
    margin: 0 0 clamp(18px, 2.4vw, 32px);
    font-family: var(--sans);
    font-size: 11px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--g-muted);
  }
  .gal-kicker span { margin: 0 8px; opacity: 0.6; }
  .gal-title {
    margin: 0;
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(46px, 8vw, 128px);
    line-height: 0.95;
    letter-spacing: -0.02em;
    color: var(--g-ink);
  }
  .gal-sub {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 14px 40px;
    margin-top: clamp(24px, 3vw, 44px);
    padding-top: 22px;
    border-top: 1px solid var(--g-rule);
  }
  .gal-sub p { margin: 0; }
  .gal-sub p:first-child {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(18px, 1.7vw, 22px);
    color: var(--g-soft);
  }
  .gal-count {
    font-family: var(--sans);
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--g-muted);
  }
  .gal-count span { margin: 0 8px; opacity: 0.6; }
  .gal-count a { color: var(--g-ink); text-decoration: none; border-bottom: 1px solid var(--g-rule); padding-bottom: 2px; transition: border-color 0.3s; }
  .gal-count a:hover { border-color: var(--g-ink); }

  /* ── Album rows: big cover + side caption, alternating ── */
  .gal-albums {
    list-style: none;
    margin: 0 auto;
    padding: 0;
    max-width: 1400px;
    display: flex;
    flex-direction: column;
    gap: clamp(72px, 11vw, 180px);
  }
  .album-row {
    display: grid;
    grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
    gap: clamp(28px, 4vw, 72px);
    align-items: end;
  }
  .album-row--flip { grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); }
  .album-row--flip .album-cover { order: 2; }
  .album-row--flip .album-text { order: 1; text-align: right; align-items: flex-end; }

  .album-cover {
    display: block;
    overflow: hidden;
    aspect-ratio: 3 / 2;
    background: #161614;
  }
  .album-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transform: scale(1.001);
    transition: transform 1.6s cubic-bezier(0.2, 0.7, 0.2, 1), filter 1.6s ease;
    filter: brightness(0.92);
  }
  .album-cover:hover img { transform: scale(1.035); filter: brightness(1); }

  .album-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding-bottom: 6px;
  }
  .album-num {
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(20px, 1.8vw, 26px);
    color: var(--g-muted);
    margin-bottom: clamp(12px, 1.6vw, 22px);
  }
  .album-title {
    margin: 0;
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(34px, 4.2vw, 64px);
    line-height: 1.02;
    letter-spacing: -0.01em;
  }
  .album-title a { color: inherit; text-decoration: none; }
  .album-meta {
    margin: clamp(14px, 1.6vw, 22px) 0 0;
    font-family: var(--sans);
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--g-soft);
  }
  .album-meta span { margin: 0 10px; opacity: 0.5; }
  .album-intro {
    margin: 18px 0 0;
    max-width: 34ch;
    font-family: var(--serif);
    font-size: clamp(17px, 1.4vw, 19px);
    line-height: 1.6;
    color: var(--g-soft);
  }
  .album-link {
    margin-top: clamp(26px, 3vw, 44px);
    font-family: var(--sans);
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--g-ink);
    text-decoration: none;
    padding-bottom: 6px;
    border-bottom: 1px solid var(--g-rule);
    transition: border-color 0.3s, gap 0.3s;
  }
  .album-link span { display: inline-block; margin-left: 8px; transition: transform 0.4s ease; }
  .album-link:hover { border-color: var(--g-ink); }
  .album-link:hover span { transform: translateX(4px); }

  @media (max-width: 860px) {
    .album-row,
    .album-row--flip { grid-template-columns: 1fr; gap: 22px; }
    .album-row--flip .album-cover { order: 0; }
    .album-row--flip .album-text { order: 1; text-align: left; align-items: flex-start; }
  }
  @media (prefers-reduced-motion: reduce) {
    .album-cover img { transition: none; }
  }
</style>
