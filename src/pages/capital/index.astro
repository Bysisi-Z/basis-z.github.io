---
import S2Layout from '../../layouts/S2Layout.astro';
import fund from '../../data/s2-capital.json';
import { runLedger, benchmarkReturn } from '../../lib/s2-ledger.mjs';

// ── Fund figures, all derived from src/data/s2-capital.json ──
// Cash, share counts and income come from the ledger; positions[] only carries market prices.
type Quote = { ticker: string; name?: string; currency?: string; lastPrice: number; lastPriceDate?: string };
const quotes = fund.positions as Quote[];
const lastClose = quotes.map((p) => p.lastPriceDate ?? '').sort().at(-1);
const ledger = runLedger(fund, lastClose);
const fxOf = (p: Quote) => (p.currency && p.currency !== 'USD'
  ? ((fund as { fx?: Record<string, { rate: number }> }).fx?.[p.currency]?.rate ?? 1) : 1);
const positions = quotes
  .filter((q) => ledger.shares[q.ticker])
  .map((q) => ({ ...q, shares: ledger.shares[q.ticker] as number, fx: fxOf(q) }));
const marketValue = positions.reduce((sum, p) => sum + p.shares * p.lastPrice * p.fx, 0);
const currentValue = ledger.cash + marketValue;
const returnPct = (currentValue / fund.initialCapital - 1) * 100;
const income = ledger.income;

// Benchmarks start on the inception date under the same price convention as the fund's
// opening trade, are marked to the same latest close, and — like the fund — include
// dividends net of the same withholding policy (held as cash, not reinvested).
type Benchmark = { ticker: string; name: string; via: string; country?: string; baseDate: string; baseConvention: string; basePrice: number; lastPrice: number; lastPriceDate: string };
const benchmarks = ((fund as { benchmarks?: Benchmark[] }).benchmarks ?? []).map((b) => {
  const r = benchmarkReturn(b, fund);
  return { ...b, ret: r.totalReturn, priceRet: r.priceReturn, divs: r.dividends, excess: returnPct - r.totalReturn };
});
const usWht = Math.round((fund.policy.withholding.US ?? 0) * 100);
const pp = (n: number) => (n > 0 ? '+' : n < 0 ? '−' : '') + Math.abs(n).toFixed(2) + ' pp';
// handed to the live-price script below
const liveFund = JSON.stringify({
  initial: fund.initialCapital,
  cash: ledger.cash,
  positions: positions.map((p) => ({ ticker: p.ticker, shares: p.shares, lastPrice: p.lastPrice, fx: p.fx })),
  benchmarks: benchmarks.map((b) => ({ ticker: b.ticker, basePrice: b.basePrice, lastPrice: b.lastPrice, divs: b.divs })),
});

const usd = (n: number) => '$' + Math.round(n).toLocaleString('en-US');
const pct = (n: number) => (n > 0 ? '+' : '') + n.toFixed(2) + '%';

const MONTHS = ['JAN','FEB','MAR','APR','MAY','JUN','JUL','AUG','SEP','OCT','NOV','DEC'];
const ledgerDate = (iso: string) => {
  const [y, m, d] = iso.split('-');
  return `${d} ${MONTHS[Number(m) - 1]} ${y}`;
};
// newest first; same-day entries keep the file's order reversed (later entry = later event)
// Split-flap board: each character gets its own tile; separators sit between tiles.
const isSep = (c: string) => c === ',' || c === '.';
const board = (str: string) => [...str].map((c) => ({ c, sep: isSep(c) }));

// ── Holdings (valued at the last close) and closed positions ──
const holdings = ledger.holdings.map((h) => {
  const q = quotes.find((x) => x.ticker === h.ticker);
  const mv = h.shares * (q?.lastPrice ?? 0) * (q ? fxOf(q) : 1);
  return {
    ...h, name: q?.name ?? h.ticker, lastPrice: q?.lastPrice ?? 0, mv,
    weight: currentValue ? (mv / currentValue) * 100 : 0,
    avgCost: h.shares ? h.cost / h.shares : 0,
    unrealized: mv - h.cost, unrealizedPct: h.cost ? (mv / h.cost - 1) * 100 : 0,
  };
}).sort((a, b) => b.mv - a.mv);
const cashWeight = currentValue ? (ledger.cash / currentValue) * 100 : 0;
const closedPositions = [...ledger.closed].reverse().map((c) => ({ ...c, name: quotes.find((q) => q.ticker === c.ticker)?.name ?? c.ticker }));

// ── Performance chart: fund NAV vs S&P 500 and XLV, all indexed to 100 at inception ──
// Benchmarks use the same total-return rule as the table (net dividends as cash).
type NavRow = { date: string; value: number; benchmarks: Record<string, number> };
const navRows = ((fund as { navHistory?: NavRow[] }).navHistory ?? []);
const CHART_SERIES = [
  { key: 'S2', label: 'S² Capital', color: '#E1181E' },
  { key: 'SPY', label: 'S&P 500', color: '#3D84C6' },
  { key: 'XLV', label: 'Health Care (XLV)', color: '#B8892A' },
];
const chartRows = navRows.map((r) => {
  const row: Record<string, number | string> = { date: r.date, S2: (r.value / fund.initialCapital) * 100 };
  for (const b of benchmarks) {
    if (r.benchmarks?.[b.ticker] == null) continue;
    row[b.ticker] = 100 + benchmarkReturn(b, fund, r.benchmarks[b.ticker], r.date).totalReturn;
  }
  return row;
});
const series = CHART_SERIES.filter((sr) => chartRows.some((r) => typeof r[sr.key] === 'number'));
const allVals = chartRows.flatMap((r) => series.map((sr) => r[sr.key] as number)).filter((v) => typeof v === 'number');
const step = 10;
const yMin = Math.floor(Math.min(100, ...allVals) / step) * step;
const yMax = Math.ceil(Math.max(100, ...allVals) / step) * step;
const yTicks = Array.from({ length: (yMax - yMin) / step + 1 }, (_, i) => yMin + i * step);
const W = 1000, H = 360;
const xOf = (i: number) => (chartRows.length > 1 ? (i / (chartRows.length - 1)) * W : 0);
const yOf = (v: number) => H - ((v - yMin) / (yMax - yMin)) * H;
const pathOf = (key: string) => chartRows
  .map((r, i) => (typeof r[key] === 'number' ? `${i ? 'L' : 'M'}${xOf(i).toFixed(1)},${yOf(r[key] as number).toFixed(1)}` : ''))
  .join('');
// month ticks along the x axis
const xTicks = chartRows
  .map((r, i) => ({ i, date: r.date as string }))
  .filter((t, k, arr) => k === 0 || t.date.slice(0, 7) !== arr[k - 1].date.slice(0, 7))
  .filter((_, k) => k % 2 === 0);
// direct labels at the line ends, nudged apart so they never overlap
const endLabels = series.map((sr) => {
  const last = [...chartRows].reverse().find((r) => typeof r[sr.key] === 'number');
  return { ...sr, v: last ? (last[sr.key] as number) : 100 };
}).sort((a, b) => b.v - a.v);
{
  const minGap = 7; // % of chart height
  let prev = -Infinity;
  for (const l of endLabels) {
    let top = (yOf(l.v) / H) * 100;
    if (top < prev + minGap) top = prev + minGap;
    (l as { top?: number }).top = top;
    prev = top;
  }
}
const chartData = JSON.stringify({ rows: chartRows, series: series.map(({ key, label, color }) => ({ key, label, color })), yMin, yMax });

// Manual journal rows plus ledger-derived events (dividends, splits, spin-offs).
const nameOf = (t: string) => {
  const n = quotes.find((q) => q.ticker === t)?.name;
  return n ? `${n} (${t})` : t;
};
const derived = ledger.events.map((e) => ({ date: e.date, type: e.type, company: nameOf(e.ticker), action: e.action, figure: e.figure }));
const journal = [...fund.journal, ...derived]
  .map((e, i) => ({ ...e, i }))
  .sort((a, b) => b.date.localeCompare(a.date) || b.i - a.i)
  .slice(0, 20);
const usd2 = (n: number) => '$' + n.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

// Trade blotter formatting
const px = (n: number) => '$' + n.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 4 });
// decision timestamps are stored with a US Eastern offset (-04:00 / -05:00)
const stamp = (iso: string) => {
  const [date, time = ''] = iso.split('T');
  const et = /-0[45]:00$/.test(time);
  return `${ledgerDate(date)} ${time.slice(0, 5)}${et ? ' ET' : ''}`.trim();
};
const trades = [...ledger.rows].reverse();   // newest first

type Article = { date: string; type: string; title: string; company: string; status: string; href?: string };
const research = [...((fund as { research?: Article[] }).research ?? [])].sort((a, b) => b.date.localeCompare(a.date));
---

<S2Layout title="S² Capital">

    <!-- 1 · Hero -->
    <section class="s2-hero">
      <h1 class="hero-statement">A virtual firm built as a $100 million experiment in public market investing.</h1>
      <div class="hero-row">
        <figure class="hero-photo">
          <img src="/images/s2/s2-headquarters.jpg" alt="S² Capital sign on a stone facade" />
          <figcaption>S² Capital <span>/</span> Lucerne <span>/</span> Est. 2026</figcaption>
        </figure>
      <div class="hero-intro">
        <p class="intro-lead">S² Capital is a virtual investment firm investing <mark class="hl">$100 million</mark> of simulated capital in real public markets.</p>
        <p class="intro-body">We research companies, build positions, track them against live market prices, and document every investment decision — from first thesis to final outcome. We revisit those decisions over time, measure their performance, and examine what we got right, what we got wrong, and why. All of our research and “trades” are published here, so we can exchange ideas and learn together.</p>
        <p class="intro-index">Portfolio <span>·</span> Investment Journal <span>·</span> Research <span>·</span> Performance</p>
      </div>
      </div>
    </section>

    <!-- 3 · The fund is live -->
    <section class="s2-section s2-wrap" id="fund" data-fund={liveFund}>
      <p class="live">
        <span class="live-dot" aria-hidden="true"></span>
        <span>Live <span class="live-sep">·</span> Current simulated portfolio value{lastClose && <span class="as-of"> (<span data-asof>Close {ledgerDate(lastClose)}</span>)</span>}</span>
      </p>
      <div class="value-row">
        <p class="capital board" data-value aria-label={usd(currentValue)}>
          {board(usd(currentValue)).map(({ c, sep }) => sep
            ? <span class="sep">{c}</span>
            : <span class="tile"><span class="t-top"><span>{c}</span></span><span class="t-bot"><span>{c}</span></span></span>)}
        </p>
        <p class="since">
          <span class="since-label">Since inception</span>
          <span class="since-value" data-return>{pct(returnPct)}</span>
        </p>
      </div>
    </section>

    <!-- Performance: chart + benchmarks + income -->
    <section class="s2-section s2-wrap" id="performance">
      <p class="marker marker--square">Performance</p>
      {chartRows.length > 1 && (
        <figure class="chart" data-chart={chartData}>
          <ul class="chart-legend">
            {series.map((sr) => <li><span class="swatch" style={`background:${sr.color}`}></span>{sr.label}</li>)}
            <li class="chart-legend-note">Indexed to 100 at inception · total return</li>
          </ul>
          <div class="chart-body">
            <div class="chart-plot">
              <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" aria-hidden="true">
                {yTicks.map((t) => <line class={t === 100 ? 'grid grid-base' : 'grid'} x1="0" x2={W} y1={yOf(t)} y2={yOf(t)} />)}
                {series.map((sr) => <path d={pathOf(sr.key)} stroke={sr.color} class={sr.key === 'S2' ? 'line line-main' : 'line'} />)}
                <line class="crosshair" x1="0" x2="0" y1="0" y2={H} />
              </svg>
              {yTicks.map((t) => <span class="y-tick" style={`top:${(yOf(t) / H) * 100}%`}>{t}</span>)}
              {endLabels.map((l) => <span class="end-label" style={`top:${(l as { top?: number }).top}%`}><span class="swatch" style={`background:${l.color}`}></span>{l.v.toFixed(1)}</span>)}
              <div class="chart-tip" role="status" aria-live="polite"></div>
            </div>
            <div class="x-axis">
              {xTicks.map((t) => <span style={`left:${(xOf(t.i) / W) * 100}%`}>{MONTHS[Number(t.date.slice(5, 7)) - 1]} {t.date.slice(2, 4)}</span>)}
            </div>
          </div>
        </figure>
      )}
      {benchmarks.length > 0 && (
        <div class="bench">
          <p class="bench-title">Since inception, against the market</p>
          <table class="bench-table">
            <thead>
              <tr>
                <th></th>
                <th>Start ({ledgerDate(fund.inception)})</th>
                <th>Latest</th>
                <th class="num">Return</th>
                <th class="num">S² excess</th>
              </tr>
            </thead>
            <tbody>
              <tr class="bench-fund">
                <td><span class="b-val">S² Capital</span></td>
                <td data-label="Start"><span class="b-val">{usd(fund.initialCapital)}</span></td>
                <td data-label="Latest"><span class="b-val" data-bench-fund-value>{usd(currentValue)}</span></td>
                <td data-label="Return" class="num"><span class="b-val" data-bench-fund-ret>{pct(returnPct)}</span></td>
                <td data-label="S² excess" class="num"><span class="b-val">—</span></td>
              </tr>
              {benchmarks.map((b) => (
                <tr data-bench={b.ticker}>
                  <td><span class="b-val">{b.name}<span class="b-sub">via {b.via}</span></span></td>
                  <td data-label="Start"><span class="b-val">${b.basePrice.toFixed(2)}<span class="b-sub">{b.baseConvention}</span></span></td>
                  <td data-label="Latest"><span class="b-val" data-bench-last>${b.lastPrice.toFixed(2)}</span></td>
                  <td data-label="Return" class="num"><span class="b-val"><span data-bench-ret>{pct(b.ret)}</span><span class="b-sub">price {pct(b.priceRet)}</span></span></td>
                  <td data-label="S² excess" class="num"><span class="b-val" data-bench-ex data-neg={b.excess < 0 ? '' : undefined}>{pp(b.excess)}</span></td>
                </tr>
              ))}
            </tbody>
          </table>
          <p class="bench-note">Total return on both sides: dividends are counted net of {usWht}% US withholding tax and held as cash, not reinvested. The fund's cash also earns interest at the 13-week T-bill rate. Benchmarks are tracked through the ETF shown.</p>

          <dl class="income">
            <div><dt>Dividends, net</dt><dd>{usd2(income.dividendsNet)}</dd></div>
            <div><dt>Withholding tax</dt><dd>{usd2(income.withholding)}</dd></div>
            <div><dt>Cash interest</dt><dd>{usd2(income.interest)}</dd></div>
            <div><dt>Commissions</dt><dd>{usd2(income.commission)}</dd></div>
            <div><dt>Slippage</dt><dd>{usd2(income.slippage)}</dd></div>
            <div><dt>Cash</dt><dd>{usd2(ledger.cash)}</dd></div>
          </dl>
        </div>
      )}
    </section>

    <!-- Holdings (at the last close) -->
    <section class="s2-section s2-wrap" id="holdings">
      <p class="marker marker--square">Holdings</p>
      {holdings.length ? (
        <>
          <table class="rtable">
            <thead>
              <tr>
                <th>Ticker</th><th>Company</th><th class="num">Shares</th><th class="num">Cost basis</th>
                <th class="num">Market value</th><th class="num">Weight</th><th class="num">Unrealized return</th>
              </tr>
            </thead>
            <tbody>
              {holdings.map((h) => (
                <tr>
                  <td data-label="Ticker"><span class="b-val t-strong">{h.ticker}</span></td>
                  <td data-label="Company"><span class="b-val">{h.name}</span></td>
                  <td data-label="Shares" class="num"><span class="b-val">{h.shares.toLocaleString('en-US')}</span></td>
                  <td data-label="Cost basis" class="num"><span class="b-val">{usd(h.cost)}<span class="b-sub">${h.avgCost.toFixed(2)}/sh</span></span></td>
                  <td data-label="Market value" class="num"><span class="b-val">{usd(h.mv)}<span class="b-sub">${h.lastPrice.toFixed(2)}/sh</span></span></td>
                  <td data-label="Weight" class="num"><span class="b-val">{h.weight.toFixed(2)}%</span></td>
                  <td data-label="Unrealized return" class="num"><span class="b-val" data-neg={h.unrealized < 0 ? '' : undefined}>{pct(h.unrealizedPct)}<span class="b-sub">{h.unrealized < 0 ? '−' : '+'}{usd(Math.abs(h.unrealized))}</span></span></td>
                </tr>
              ))}
              <tr class="row-cash">
                <td data-label="Ticker"><span class="b-val t-strong">Cash</span></td>
                <td data-label="Company"><span class="b-val">USD, earning the 13-week T-bill rate</span></td>
                <td data-label="Shares" class="num"><span class="b-val">—</span></td>
                <td data-label="Cost basis" class="num"><span class="b-val">—</span></td>
                <td data-label="Market value" class="num"><span class="b-val">{usd(ledger.cash)}</span></td>
                <td data-label="Weight" class="num"><span class="b-val">{cashWeight.toFixed(2)}%</span></td>
                <td data-label="Unrealized return" class="num"><span class="b-val">—</span></td>
              </tr>
            </tbody>
          </table>
          <p class="table-note">Valued at the {lastClose && ledgerDate(lastClose)} close. Cost basis includes commissions and slippage; unrealized return excludes dividends received ({usd(holdings.reduce((x, h) => x + h.dividends, 0))} net so far).</p>
        </>
      ) : (
        <p class="empty">No open positions. The fund is fully in cash.</p>
      )}
    </section>

    <!-- 4 · Investment journal -->
    <section class="s2-section s2-wrap" id="journal">
      <p class="marker marker--square">Investment history</p>
      <ol class="ledger">
        <li class="ledger-head" aria-hidden="true">
          <span>Date</span><span>Type</span><span>Company</span><span>Action</span><span class="num">Detail</span>
        </li>
        {journal.map((e) => (
          <li class="ledger-row">
            <span class="l-date">{ledgerDate(e.date)}</span>
            <span class="l-type">{e.type}</span>
            <span class="l-company">{e.company}</span>
            <span class="l-action">{e.action}</span>
            <span class="l-figure num">{e.figure}</span>
          </li>
        ))}
      </ol>
    </section>

    <!-- 4b · Trade blotter (derived by src/lib/s2-ledger.mjs) -->
    <section class="s2-section s2-wrap" id="trades">
      <p class="marker marker--square">Trades</p>
      {trades.length ? (
        <div class="blotter-scroll">
          <table class="blotter">
            <thead>
              <tr>
                <th>Trade</th>
                <th>Decision</th>
                <th>Executed</th>
                <th>Price convention</th>
                <th class="num">Shares</th>
                <th class="num">Fill price</th>
                <th class="num">Gross consideration</th>
                <th class="num">Commission</th>
                <th class="num">Slippage</th>
                <th class="num">Cash after</th>
                <th class="num">Weight after</th>
              </tr>
            </thead>
            <tbody>
              {trades.map((t) => (
                <tr>
                  <td data-label="Trade"><span class="b-val"><span class="b-side" data-side={t.side}>{t.side}</span> {t.ticker}</span></td>
                  <td data-label="Decision"><span class="b-val">{stamp(t.decisionAt)}</span></td>
                  <td data-label="Executed"><span class="b-val">{ledgerDate(t.executionDate)}</span></td>
                  <td data-label="Price convention"><span class="b-val">{t.convention}<span class="b-sub">ref {px(t.referencePrice)}</span></span></td>
                  <td data-label="Shares" class="num"><span class="b-val">{t.shares.toLocaleString('en-US')}</span></td>
                  <td data-label="Fill price" class="num"><span class="b-val">{px(Math.round(t.fillPrice * 10000) / 10000)}</span></td>
                  <td data-label="Gross consideration" class="num"><span class="b-val">{usd2(t.gross)}</span></td>
                  <td data-label="Commission" class="num"><span class="b-val">{usd2(t.commission)}</span></td>
                  <td data-label="Slippage" class="num"><span class="b-val">{usd2(t.slippage)}<span class="b-sub">{t.slippageBps} bps</span></span></td>
                  <td data-label="Cash after" class="num"><span class="b-val">{usd2(t.cashAfter)}</span></td>
                  <td data-label="Weight after" class="num"><span class="b-val">{(t.weightAfter * 100).toFixed(2)}%</span></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ) : (
        <p class="empty">No trades yet.</p>
      )}
    </section>

    <!-- Closed positions: every exit stays on the record, win or lose -->
    <section class="s2-section s2-wrap" id="closed">
      <p class="marker marker--square">Closed positions</p>
      {closedPositions.length ? (
        <table class="rtable rtable--wide">
          <thead>
            <tr>
              <th>Ticker</th><th>Company</th><th>Held</th><th class="num">Invested</th><th class="num">Proceeds</th>
              <th class="num">Dividends</th><th class="num">P&amp;L</th><th class="num">Return</th>
            </tr>
          </thead>
          <tbody>
            {closedPositions.map((c) => (
              <tr>
                <td data-label="Ticker"><span class="b-val t-strong">{c.ticker}</span></td>
                <td data-label="Company"><span class="b-val">{c.name}</span></td>
                <td data-label="Held"><span class="b-val">{ledgerDate(c.opened)} → {ledgerDate(c.closedOn)}</span></td>
                <td data-label="Invested" class="num"><span class="b-val">{usd(c.invested)}</span></td>
                <td data-label="Proceeds" class="num"><span class="b-val">{usd(c.proceeds)}</span></td>
                <td data-label="Dividends" class="num"><span class="b-val">{usd(c.dividends)}</span></td>
                <td data-label="P&amp;L" class="num"><span class="b-val" data-neg={c.pnl < 0 ? '' : undefined}>{c.pnl < 0 ? '−' : '+'}{usd(Math.abs(c.pnl))}</span></td>
                <td data-label="Return" class="num"><span class="b-val" data-neg={c.pnl < 0 ? '' : undefined}>{pct(c.returnPct)}</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      ) : (
        <p class="empty">No closed positions yet. Every exit will stay on this list permanently, including the losses.</p>
      )}
    </section>

    <!-- 5 · Research articles (src/data/s2-capital.json → research) -->
    <section class="s2-section s2-wrap" id="research">
      <p class="marker marker--square">Research</p>
      {research.length ? (
        <ol class="articles">
          {research.map((r) => {
            const Tag = r.href ? 'a' : 'div';
            return (
              <li>
                <Tag class="article" {...(r.href ? { href: r.href } : {})}>
                  <span class="a-date">{ledgerDate(r.date)}</span>
                  <span class="a-type">{r.type}</span>
                  <span class="a-main">
                    <span class="a-title">{r.title}</span>
                    <span class="a-company">{r.company}</span>
                  </span>
                  <span class="a-status">{r.status}</span>
                </Tag>
              </li>
            );
          })}
        </ol>
      ) : (
        <p class="empty">First research notes are on the way.</p>
      )}
    </section>

</S2Layout>

<script>
  // Day counter: day 001 = inception date, counted in the visitor's local calendar
  document.querySelectorAll<HTMLElement>('[data-day]').forEach((el) => {
    const [y, m, d] = (el.dataset.inception ?? '').split('-').map(Number);
    if (!y) return;
    const start = new Date(y, m - 1, d);
    const now = new Date();
    const today = new Date(now.getFullYear(), now.getMonth(), now.getDate());
    const day = Math.max(1, Math.round((today.getTime() - start.getTime()) / 86400000) + 1);
    el.textContent = String(day).padStart(3, '0');
  });

  // Split-flap board. Each tile flips in turn from the left: the upper leaf falls to
  // reveal the new character's top half, then the lower leaf drops over the bottom half.
  // Digits spin through a couple of interim values first, like an exchange board.
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const isSep = (c: string) => c === ',' || c === '.';
  const LEAF_MS = 70;

  const tileHTML = (c: string) => isSep(c)
    ? `<span class="sep">${c}</span>`
    : `<span class="tile"><span class="t-top"><span>${c}</span></span><span class="t-bot"><span>${c}</span></span></span>`;

  const leaf = (tile: HTMLElement, cls: string, c: string) => {
    const el = document.createElement('span');
    el.className = `leaf ${cls}`;
    el.innerHTML = `<span>${c}</span>`;
    tile.append(el);
    return el;
  };

  const flipTile = async (tile: HTMLElement, seq: string[]) => {
    const top = tile.querySelector<HTMLElement>('.t-top > span')!;
    const bot = tile.querySelector<HTMLElement>('.t-bot > span')!;
    for (const next of seq) {
      const prev = top.textContent ?? '';
      top.textContent = next;                       // revealed as the upper leaf falls
      const up = leaf(tile, 'leaf-top', prev);
      await up.animate([{ transform: 'rotateX(0deg)' }, { transform: 'rotateX(-90deg)' }],
        { duration: LEAF_MS, easing: 'ease-in' }).finished;
      up.remove();
      const down = leaf(tile, 'leaf-bot', next);
      await down.animate([{ transform: 'rotateX(90deg)' }, { transform: 'rotateX(0deg)' }],
        { duration: LEAF_MS, easing: 'ease-out' }).finished;
      bot.textContent = next;
      down.remove();
    }
  };

  const flipTo = (el: HTMLElement | null, next: string) => {
    if (!el || el.getAttribute('aria-label') === next) return;
    const prev = el.getAttribute('aria-label') ?? '';
    el.setAttribute('aria-label', next);
    const sameShape = prev.length === next.length && [...prev].every((c, i) => isSep(c) === isSep(next[i]));
    if (reduceMotion || !sameShape) {
      el.innerHTML = [...next].map(tileHTML).join('');
      return;
    }
    const slots = [...el.children] as HTMLElement[];
    [...next].forEach((c, i) => {
      if (isSep(c) || prev[i] === c) return;
      const spins = /\d/.test(c) ? Array.from({ length: 2 }, () => String(Math.floor(Math.random() * 10))) : [];
      setTimeout(() => flipTile(slots[i], [...spins, c]), i * 90);
    });
  };

  // Live value: build-time figures use the last recorded close; while the page is open,
  // re-price positions from /api/quotes every 5 minutes. Any failure keeps the close figures.
  // (npm run dev has no Pages Functions, so dev simulates small price moves to show the board.)
  const fundEl = document.querySelector<HTMLElement>('[data-fund]');
  if (fundEl) {
    type LiveFund = {
      initial: number; cash: number;
      positions: { ticker: string; shares: number; lastPrice: number; fx: number }[];
      benchmarks: { ticker: string; basePrice: number; lastPrice: number; divs: number }[];
    };
    const f: LiveFund = JSON.parse(fundEl.dataset.fund ?? '{}');
    const tickers = f.positions.map((p) => p.ticker);
    const benchTickers = (f.benchmarks ?? []).map((b) => b.ticker);
    const signed = (n: number) => (n > 0 ? '+' : '') + n.toFixed(2) + '%';
    const pp = (n: number) => (n > 0 ? '+' : n < 0 ? '−' : '') + Math.abs(n).toFixed(2) + ' pp';
    const valueEl = fundEl.querySelector<HTMLElement>('[data-value]');
    const returnEl = fundEl.querySelector<HTMLElement>('[data-return]');
    const asOfEl = fundEl.querySelector('[data-asof]');

    const refresh = async () => {
      if (!tickers.length || document.hidden) return;
      try {
        let quotes: Record<string, { price: number; time: number }>;
        if (import.meta.env.DEV) {
          quotes = Object.fromEntries([...f.positions, ...(f.benchmarks ?? [])].map((p) => [p.ticker, {
            price: p.lastPrice * (1 + (Math.random() - 0.5) * 0.02),
            time: Date.now() / 1000,
          }]));
        } else {
          const res = await fetch(`/api/quotes?symbols=${[...tickers, ...benchTickers].join(',')}`);
          if (!res.ok) return;
          ({ quotes } = await res.json());
        }
        if (!tickers.every((t) => quotes?.[t])) return;
        const value = f.cash + f.positions.reduce((s, p) => s + p.shares * quotes[p.ticker].price * p.fx, 0);
        const ret = (value / f.initial - 1) * 100;
        flipTo(valueEl, '$' + Math.round(value).toLocaleString('en-US'));
        if (returnEl) returnEl.textContent = signed(ret);
        const fundValueCell = document.querySelector('[data-bench-fund-value]');
        const fundRetCell = document.querySelector('[data-bench-fund-ret]');
        if (fundValueCell) fundValueCell.textContent = '$' + Math.round(value).toLocaleString('en-US');
        if (fundRetCell) fundRetCell.textContent = signed(ret);
        for (const b of f.benchmarks ?? []) {
          const q = quotes[b.ticker];
          const row = document.querySelector(`[data-bench="${b.ticker}"]`);
          if (!q || !row) continue;
          const bRet = ((q.price + b.divs) / b.basePrice - 1) * 100;   // total return, net dividends as cash
          const ex = ret - bRet;
          const exEl = row.querySelector<HTMLElement>('[data-bench-ex]');
          row.querySelector('[data-bench-last]')!.textContent = '$' + q.price.toFixed(2);
          row.querySelector('[data-bench-ret]')!.textContent = signed(bRet);
          if (exEl) { exEl.textContent = pp(ex); exEl.toggleAttribute('data-neg', ex < 0); }
        }
        const t = new Date(Math.max(...tickers.map((s) => quotes[s].time)) * 1000);
        const fmt = (o: Intl.DateTimeFormatOptions) => t.toLocaleString('en-US', { timeZone: 'America/New_York', ...o });
        if (asOfEl) asOfEl.textContent = `${fmt({ day: '2-digit' })} ${fmt({ month: 'short' }).toUpperCase()} ${fmt({ hour: '2-digit', minute: '2-digit', hourCycle: 'h23' })} ET`;
      } catch { /* keep last close */ }
    };
    setTimeout(refresh, import.meta.env.DEV ? 1500 : 0);
    setInterval(refresh, 5 * 60_000);
  }

  // Performance chart hover: nearest trading day → crosshair + values for every series.
  const chart = document.querySelector<HTMLElement>('[data-chart]');
  if (chart) {
    type ChartData = { rows: Record<string, number | string>[]; series: { key: string; label: string; color: string }[] };
    const data: ChartData = JSON.parse(chart.dataset.chart ?? '{}');
    const plot = chart.querySelector<HTMLElement>('.chart-plot')!;
    const line = chart.querySelector<SVGLineElement>('.crosshair')!;
    const tip = chart.querySelector<HTMLElement>('.chart-tip')!;
    const M = ['JAN','FEB','MAR','APR','MAY','JUN','JUL','AUG','SEP','OCT','NOV','DEC'];
    const fmtDate = (iso: string) => `${iso.slice(8, 10)} ${M[Number(iso.slice(5, 7)) - 1]} ${iso.slice(0, 4)}`;
    const show = (clientX: number) => {
      const box = plot.getBoundingClientRect();
      const t = Math.min(1, Math.max(0, (clientX - box.left) / box.width));
      const i = Math.round(t * (data.rows.length - 1));
      const row = data.rows[i];
      const x = (i / (data.rows.length - 1)) * 1000;
      line.setAttribute('x1', String(x));
      line.setAttribute('x2', String(x));
      chart.classList.add('is-hover');
      tip.innerHTML = `<p class="tip-date">${fmtDate(String(row.date))}</p>` + data.series
        .filter((sr) => typeof row[sr.key] === 'number')
        .map((sr) => `<p><span class="swatch" style="background:${sr.color}"></span>${sr.label}<b>${(row[sr.key] as number).toFixed(1)}</b></p>`)
        .join('');
      const left = (i / (data.rows.length - 1)) * box.width;
      tip.style.left = `${Math.min(Math.max(left, 90), box.width - 90)}px`;
    };
    plot.addEventListener('pointermove', (e) => show(e.clientX));
    plot.addEventListener('pointerdown', (e) => show(e.clientX));
    plot.addEventListener('pointerleave', () => chart.classList.remove('is-hover'));
  }
</script>

