---
import S2Layout from '../../layouts/S2Layout.astro';
---

<S2Layout title="Meet our team — S² Capital" active="team">
  <section class="team s2-wrap">
    <p class="marker marker--square">Meet our team</p>
    <h1 class="team-title">Meet our team</h1>
    <p class="empty">Team profiles are coming soon.</p>
  </section>
</S2Layout>

<style>
  .team { padding-top: clamp(48px, 6vw, 96px); }
  .team-title {
    font-family: var(--serif);
    font-size: clamp(40px, 5vw, 80px);
    font-weight: 300;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--s2-ink);
    margin-bottom: 32px;
  }
</style>
